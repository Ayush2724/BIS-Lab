import numpy as np
import random

class DNAAntColonyAlignment:
    def __init__(self, seq1, seq2, n_ants=10, max_iter=30, alpha=1.0, beta=2.0, evaporation=0.1, Q=10):
        self.seq1 = seq1
        self.seq2 = seq2
        self.M = len(seq1)
        self.N = len(seq2)
        
        # Hyperparameters
        self.n_ants = n_ants
        self.max_iter = max_iter
        self.alpha = alpha  # Pheromone importance
        self.beta = beta    # Heuristic importance
        self.evaporation = evaporation
        self.Q = Q          # Pheromone deposit factor
        
        # Scoring System
        self.match_score = 2
        self.mismatch_score = -1
        self.gap_penalty = -2
        
        # Pheromone grid: Shapes match possible state transitions (Diagonal, Horizontal, Vertical)
        # We track pheromones on the nodes (i, j) for the 3 incoming directions
        self.pheromone = np.ones((self.M + 1, self.N + 1, 3)) 

    def _heuristic(self, i, j, move_type):
        """Calculates the local attractiveness (heuristic value) of a move."""
        if move_type == 0:  # Diagonal (Align seq1[i] and seq2[j])
            score = self.match_score if self.seq1[i] == self.seq2[j] else self.mismatch_score
        else:  # Horizontal or Vertical (Gap)
            score = self.gap_penalty
        
        # Normalize to positive value for probability calculation
        return max(0.1, score + 3) 

    def _construct_solution(self):
        """Simulates one ant walking through the alignment grid."""
        i, j = 0, 0
        path = [(0, 0, 0)]  # tracks (i, j, move_type)
        total_score = 0
        
        while i < self.M or j < self.N:
            allowed_moves = []
            probabilities = []
            
            # Move 0: Diagonal (both sequences advance)
            if i < self.M and j < self.N:
                allowed_moves.append((i + 1, j + 1, 0))
            # Move 1: Horizontal (seq2 advances, gap in seq1)
            if j < self.N:
                allowed_moves.append((i, j + 1, 1))
            # Move 2: Vertical (seq1 advances, gap in seq2)
            if i < self.M:
                allowed_moves.append((i + 1, j, 2))
                
            for next_i, next_j, move_type in allowed_moves:
                tau = self.pheromone[next_i, next_j, move_type] ** self.alpha
                eta = self._heuristic(i, j, move_type) ** self.beta
                probabilities.append(tau * eta)
                
            prob_sum = sum(probabilities)
            probabilities = [p / prob_sum for p in probabilities]
            
            # Select next step based on probabilities
            next_step = allowed_moves[np.random.choice(len(allowed_moves), p=probabilities)]
            
            # Accumulate true biological score
            if next_step[2] == 0:
                total_score += self.match_score if self.seq1[i] == self.seq2[j] else self.mismatch_score
            else:
                total_score += self.gap_penalty
                
            i, j, _ = next_step
            path.append(next_step)
            
        return path, total_score

    def _update_pheromones(self, all_paths):
        """Evaporates old trails and deposits new pheromones based on path quality."""
        self.pheromone *= (1 - self.evaporation)
        for path, score in all_paths:
            # Shift score to be strictly positive for reinforcement scale
            fitness = max(0.1, score + (2 * max(self.M, self.N))) 
            for i, j, move_type in path[1:]:
                self.pheromone[i, j, move_type] += (self.Q * fitness)

    def _reconstruct_alignment(self, path):
        """Converts the grid path into readable aligned string sequences."""
        align1, align2 = [], []
        curr_i, curr_j = 0, 0
        
        for next_i, next_j, move_type in path[1:]:
            if move_type == 0:
                align1.append(self.seq1[curr_i])
                align2.append(self.seq2[curr_j])
            elif move_type == 1:
                align1.append('-')
                align2.append(self.seq2[curr_j])
            elif move_type == 2:
                align1.append(self.seq1[curr_i])
                align2.append('-')
            curr_i, curr_j = next_i, next_j
            
        return "".join(align1), "".join(align2)

    def run(self):
        """Executes the ACO loop over defined iterations."""
        best_score = float('-inf')
        best_path = None
        
        for _ in range(self.max_iter):
            iteration_solutions = []
            for _ in range(self.n_ants):
                path, score = self._construct_solution()
                iteration_solutions.append((path, score))
                
                if score > best_score:
                    best_score = score
                    best_path = path
                    
            self._update_pheromones(iteration_solutions)
            
        align1, align2 = self._reconstruct_alignment(best_path)
        return align1, align2, best_score

# --- Example Evaluation ---
if __name__ == "__main__":
    sequence_a = "ACCGTGGAC"
    sequence_b = "ACCTGGAC"
    
    print(f"Seq 1: {sequence_a}")
    print(f"Seq 2: {sequence_b}\n")
    
    aco_aligner = DNAAntColonyAlignment(sequence_a, sequence_b, n_ants=15, max_iter=50)
    aligned_a, aligned_b, score = aco_aligner.run()
    
    print("--- Optimal ACO Alignment Result ---")
    print(f"Aligned 1: {aligned_a}")
    print(f"Aligned 2: {aligned_b}")
    print(f"Alignment Score: {score}")
